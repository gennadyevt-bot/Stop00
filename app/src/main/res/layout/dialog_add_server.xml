<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Новый сервер"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Название (например: NL-AMS-01)"
            android:inputType="text" />

        <EditText
            android:id="@+id/etCountry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Страна (например: Нидерланды)"
            android:inputType="text"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etEndpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Endpoint (IP:порт)"
            android:inputType="text"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etPrivateKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Приватный ключ"
            android:inputType="text"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etPublicKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Публичный ключ сервера"
            android:inputType="text"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AmneziaWG обфускация (опционально)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etJc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jc (по умолч. 5)"
            android:inputType="number" />

        <EditText
            android:id="@+id/etJmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jmin (по умолч. 50)"
            android:inputType="number"
            android:layout_marginTop="6dp" />

        <EditText
            android:id="@+id/etJmax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jmax (по умолч. 1000)"
            android:inputType="number"
            android:layout_marginTop="6dp" />

        <EditText
            android:id="@+id/etS1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="S1 (по умолч. 50)"
            android:inputType="number"
            android:layout_marginTop="6dp" />

        <EditText
            android:id="@+id/etS2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="S2 (по умолч. 100)"
            android:inputType="number"
            android:layout_marginTop="6dp" />

        <EditText
            android:id="@+id/etH1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="H1 (по умолч. 1)"
            android:inputType="number"
            android:layout_marginTop="6dp" />

        <EditText
            android:id="@+id/etH2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="H2 (по умолч. 2)"
            android:inputType="number"
            android:layout_marginTop="6dp" />

        <EditText
            android:id="@+id/etH3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="H3 (по умолч. 3)"
            android:inputType="number"
            android:layout_marginTop="6dp" />

        <EditText
            android:id="@+id/etH4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="H4 (по умолч. 4)"
            android:inputType="number"
            android:layout_marginTop="6dp" />

    </LinearLayout>
</ScrollView>
